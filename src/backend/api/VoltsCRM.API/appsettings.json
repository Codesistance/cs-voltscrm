{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=voltscrm;Username=postgres"
  },
  "Jwt": {
    "Issuer": "VoltsCRM",
    "Audience": "VoltsCRM",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Auth": {
    "RefreshTokenInBody": false
  },
  "Phoenix": {
    "Enabled": false
  },
  "Billing": {
    "DefaultCurrency": "NGN"
  },
  "Email": {
    "FromAddress": "",
    "AppBaseUrl": "http://localhost:5173"
  },
  "Geocoding": {
    "BaseUrl": "https://nominatim.openstreetmap.org",
    "UserAgent": "VoltsCRM/1.0 (admin@voltscrm.local)",
    "MaxResults": 5,
    "MinSecondsBetweenCalls": 1.0,
    "CacheMinutes": 60
  }
}
